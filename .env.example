# HeDiao3D V3 environment template
# Copy this file to .env on the deployment machine and fill real secrets there.
# Do not commit .env.

# Local API server
API_PORT=8787

# Meshy cloud API proxy
MESHY_API_BASE=https://api.meshy.ai
MESHY_API_KEY=

# Toolpath preview/cache limits
MAX_TOOLPATH_PREVIEW_POINTS=650000

# Orchestrator queue
ORCHESTRATOR_CONCURRENCY=1

# External CAM adapters
# Keep false until FreeCAD/BlenderCAM/CAMotics/OpenCAMLib are installed and dry-run is verified.
ENABLE_EXTERNAL_CAM_ADAPTERS=false
EXTERNAL_CAM_ADAPTER_TIMEOUT_MS=120000
# Extra safety switch for FreeCAD Path output. Keep false until the generated
# freecad-cam-plan.json and freecad-run-template.py have been validated on the
# deployment server with a small non-production model.
HEDIAO3D_FREECAD_EXPERIMENTAL_OUTPUT=false
# Extra safety switch for CAMotics CLI material-removal execution. Keep false
# until camotics-simulation-plan.json and camotics-project-template.json have
# been validated on the deployment server.
HEDIAO3D_CAMOTICS_EXPERIMENTAL_RUN=false

# Mesh repair execution
# Keep false by default. When true, Orchestrator may enter backend mesh repair workflow
# if MESHY_API_KEY is configured and repair is required.
ORCHESTRATOR_AUTO_MESH_REPAIR=false
